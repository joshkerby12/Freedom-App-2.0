# Freedom App 2.0 — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env — it is in .gitignore

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Deepgram (Speech to Text)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Plaid (Bank Integration)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# QuickBooks
QB_CLIENT_ID=your-quickbooks-client-id
QB_CLIENT_SECRET=your-quickbooks-client-secret

# Firebase (FCM) — add google-services.json and GoogleService-Info.plist separately
# These files are NOT stored in .env — see architecture.md Pre-Launch Dependencies
